<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Wsla.Server</RootNamespace>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AssemblyName>Wsla-$(MSBuildProjectName)</AssemblyName>
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shared-Server\Shared-Server.csproj" />

		<ProjectReference Include="../Network-Generator/Network-Generator.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
		</ProjectReference>

		<ProjectReference Include="..\Control-Panel\Control-Panel.csproj" PrivateAssets="all" />

		<ProjectReference Include="..\Shared-Web\Shared-Web.csproj" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.4" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Schema\" />
		<Content Update="Schema\Configuration.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

		<None Update="Configuration.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Schema\Configuration.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
