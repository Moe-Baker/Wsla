<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Wsla-$(MSBuildProjectName)</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Network-Generator\Network-Generator.csproj" />
		<ProjectReference Include="..\Shared-Global\Shared-Global.csproj" />
		<ProjectReference Include="..\Shared-Server\Shared-Server.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Network-Generator/Network-Generator.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<OutputItemType>Analyzer</OutputItemType>
		</ProjectReference>
	</ItemGroup>

	<ProjectExtensions><VisualStudio><UserProperties configuration_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
