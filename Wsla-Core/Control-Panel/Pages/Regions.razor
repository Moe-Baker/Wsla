@page "/regions"
@inject HttpClient Http

<PageTitle>Regions</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates fetching data from the server.</p>

@if (list == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        @foreach (var relay in list)
        {
            <MudText>@relay.Info.Address - @relay.Info.Region</MudText>
        }
    </table>
}

@code {
    private List<RelayServerRegistration> list;

    protected override async Task OnInitializedAsync()
    {
        list = await Http.GetFromJsonAsync<List<RelayServerRegistration>>(Constants.RestRoutes.ListRelays, options: SharedServerAPI.JsonOptions);
    }
}
