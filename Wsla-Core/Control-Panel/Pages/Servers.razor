@page "/servers"

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Servers</PageTitle>

<h1>Servers</h1>

@if (list == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>(@list.Count) Relay Servers Registered</p>

    <ul class="table">
        @foreach (var relay in list)
        {
            <li>
                <MudText>@relay.Info.Address - @relay.Info.Region (@relay.Occupancy)</MudText>
                <MudButton OnClick="() => NavigateTo(relay)">List Rooms</MudButton>
            </li>
        }
    </ul>
}

@code {
    List<RelayServerAdminInfo> list;

    protected override async Task OnInitializedAsync()
    {
        list = await Http.GetFromJsonAsync<List<RelayServerAdminInfo>>(Constants.RestRoutes.Administration.ListRelays, options: SharedServerAPI.JsonOptions);
    }

    public void NavigateTo(RelayServerAdminInfo registration)
    {
        Console.WriteLine(Navigation.BaseUri);

        Navigation.NavigateTo($"{Navigation.BaseUri}rooms/{registration.ID}");
    }
}
