@page "/servers"
@inject HttpClient Http

<PageTitle>Servers</PageTitle>

<h1>Servers</h1>

@if (list == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Registered (@list.Count) Relay Servers</p>

    <table class="table">
        @foreach (var relay in list)
        {
            <RelayServerEntryUI Server=relay></RelayServerEntryUI>
        }
    </table>
}

@code {
    private List<RelayServerRegistration> list;

    protected override async Task OnInitializedAsync()
    {
        list = await Http.GetFromJsonAsync<List<RelayServerRegistration>>(Constants.RestRoutes.ListRelays, options: SharedServerAPI.JsonOptions);
    }
}
