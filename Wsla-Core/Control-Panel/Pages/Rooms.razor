@page "/rooms/{ID:guid}"
@inject HttpClient Http

@using System.Net

<PageTitle>Rooms</PageTitle>

<h1>Rooms</h1>

@if (list == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>(@list.Count) Rooms Registered</p>

    <table class="table">
        @foreach (var room in list)
        {
            <MudText>@room.State.Name (@room.State.Occupancy/@room.State.Capacity)</MudText>
        }
    </table>
}

@code {
    [Parameter]
    public Guid ID { get; set; }

    List<RelayRoomAdminInfo> list;

    protected override async Task OnInitializedAsync()
    {
        var response = await Http.PostAsJsonAsync(Constants.RestRoutes.Administration.ListRooms, ID, options: SharedServerAPI.JsonOptions);

        list = await response.Content.ReadFromJsonAsync<List<RelayRoomAdminInfo>>(options: SharedServerAPI.JsonOptions);
    }
}
